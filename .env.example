# Variables déjà utilisées par Signal Call
VOICE_ADMIN_API_KEY=
PUBLIC_BASE_URL=https://synial-call.onrender.com
MAIN_APP_BASE_URL=https://www.synial.fr
INTERNAL_APP_TOKEN=

# Authentification du casque Quest standalone
QUEST_DEVICE_TOKEN=
QUEST_DEVICE_TIMEOUT_SECONDS=45
QUEST_LONG_POLL_SECONDS=20

# Appels téléphoniques SYNIAL. Le relais Quest reste indépendant.
VOICE_CALL_PROVIDER=openai
# Clé de projet serveur uniquement, à configurer sur le service vocal.
OPENAI_API_KEY=
OPENAI_PHONE_MODEL=gpt-live-1
OPENAI_PHONE_VOICE_JOURNALISTE=brise
OPENAI_PHONE_VOICE_PREFET=sillage
OPENAI_PHONE_VOICE_COLONEL_POMPIERS=sillage
OPENAI_PHONE_CODEC=pcm
OPENAI_PHONE_PLAYBACK_LEAD_MS=60
OUT_QUEUE_MAX_FRAMES=25
LOG_LEVEL=INFO

# Transcription et résumé après raccrochage
ENABLE_TRANSCRIPTIONS=true
TRANSCRIBE_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Alternative à la clé Gemini, avec les identifiants Google du service.
GOOGLE_CLOUD_PROJECT=
VOICE_POSTCALL_GOOGLE_LOCATION=
# Répertoire privé sur disque persistant en production.
VOICE_POSTCALL_DIR=
VOICE_RECORD_MAX_SECONDS=1800
